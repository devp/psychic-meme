# Tasks about the starter. The app's own tasks are in app/justfile.

default:
    @just --list

# Copy app/ (as committed) to <dest>, relative to the repo root, stamped with STARTER.
new-app dest:
    scripts/new-app.sh {{dest}}

# Diff <app> against its last starter stamp: what the starter and the app each changed since. Default --stat.
drift app *args:
    scripts/drift.sh {{app}} {{args}}

# Merge starter changes to CORE files into <app> and stamp STARTER-LAST-UPDATED. Conflicts are left as markers.
sync app:
    scripts/sync.sh {{app}}
