# Tasks about the starter. The app's own tasks are in app/justfile.

default:
    @just --list

# Copy app/ (as committed) to <dest> (absolute, else relative to the repo root), stamped with STARTER. <name> defaults to basename of <dest>.
new-app dest name="":
    scripts/new-app.sh {{dest}} {{name}}

# Diff <app> (a path; may be in another repo) against its last starter stamp: what the starter and the app each changed since. Default --stat.
drift app *args:
    scripts/drift.sh {{app}} {{args}}

# Merge starter changes to CORE files into <app> (a path; may be in another repo) and stamp STARTER-LAST-UPDATED. Conflicts are left as markers.
sync app:
    scripts/sync.sh {{app}}
